{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "action": { "type": "string" },
          "targets": {
            "type": "array",
            "items": { "type": "string" }
          },
          "content": { "type": ["string", "null"] },
          "attributes": { "type": "object" }
        },
        "required": ["action", "targets", "content", "attributes"]
      }
    }
  },
  "required": ["actions"]
}
